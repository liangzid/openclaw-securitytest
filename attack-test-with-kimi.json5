{
  // 这是用于攻击测试的 OpenClaw 配置
  // 使用 KIMI_API_KEY 环境变量

  env: {
    // 从环境变量读取 KIMI_API_KEY
    // export KIMI_API_KEY="你的 KIMI API KEY"
  },

  agents: {
    defaults: {
      model: {
        primary: "kimi-coding/k2p5"
      }
    }
  },

  models: {
    mode: "merge",
    default: "kimi-coding/k2p5",
    providers: {
      "kimi-coding": {
        api: "openai-completions",
        baseUrl: "https://api.moonshot.cn/v1",
        apiKey: "${KIMI_API_KEY}",
        models: [
          {
            id: "k2p5",
            name: "Kimi K2.5",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 8192,
          }
        ]
      }
    }
  },

  session: {
    scope: "per-sender",
    mainKey: "attack-test-session"
  },

  tools: {
    // 注意：为了攻击测试，我们暂时放开这些工具
    // 生产环境请保持安全设置！
    exec: {
      allow: true,
      ask: false
    },
    fs_read: {
      allow: true
    },
    fs_write: {
      allow: true
    },
    web_fetch: {
      allow: true
    }
  },

  channels: {
    // 禁用所有渠道，只使用 CLI
    whatsapp: { enabled: false },
    telegram: { enabled: false },
    discord: { enabled: false },
    slack: { enabled: false },
    signal: { enabled: false },
    irc: { enabled: false }
  },

  logging: {
    level: "debug"
  }
}
