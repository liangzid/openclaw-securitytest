{
  // 这是用于攻击测试的 OpenClaw 配置
  // 使用 KIMI_API_KEY 环境变量

  env: {
    // 从环境变量读取 KIMI_API_KEY
    // export KIMI_API_KEY="你的 KIMI API KEY"
  },

  agents: {
    defaults: {
      model: {
        primary: "moonshot/kimi-k2.5"
      },
      models: {
        "moonshot/kimi-k2.5": { alias: "Kimi K2.5" }
      }
    }
  },

  models: {
    mode: "merge",
    providers: {
      moonshot: {
        api: "openai-completions",
        baseUrl: "https://api.moonshot.cn/v1",
        apiKey: "${KIMI_API_KEY}",
        models: [
          {
            id: "kimi-k2.5",
            name: "Kimi K2.5",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 8192
          }
        ]
      }
    }
  },

  session: {
    scope: "per-sender"
  },

  tools: {
    // 工具配置使用 profile 和 allow/deny 列表
    // 可选的 profile: "minimal" | "coding" | "messaging" | "full"
    profile: "full",
    exec: {
      security: "full",
      ask: "off"
    },
    web: {
      fetch: {
        enabled: true
      }
    }
  },

  logging: {
    level: "debug"
  }
}
